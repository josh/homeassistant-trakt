{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "update-lockfile",
  "postUpgradeTasks": {
    "commands": ["sync-ha-python-version"],
    "fileFilters": [".python-version"]
  },
  "packageRules": [
    {
      "description": ".python-version tracks Home Assistant's pin; the lockfile job enforces it",
      "matchManagers": ["pyenv"],
      "enabled": false
    }
  ]
}
